NOP
END

AREA TRANSFER,CODE,READONLY
LDR R1,=VALUE1
LDR R2,[R1]
LDR R4,=RESULT
STR R2,[R4]

VALUE1 DCD 0x4535
AREA DATA2,DATA,READWRITE
RESULT DCD 0x1
END
