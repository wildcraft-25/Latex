AREA COUNT_BIT,CODE,READONLY
ENTRY

START
    LDR R0,=DATA1
    LDR R1,[R0]
    LDR R4,[R0,#4]

    MOV R2,#0      ; 
    MOV R3,#0      ; 
    MOV R5,#64     ; 

LOOP
    MOVS R1,R1,LSR #1
    ADCS R2,R2,#1
    ADCC R3,R3,#1

    CMP R5,#32
    MOVEQ R1,R4

    SUBS R5,R5,#1
    BNE LOOP

STOP B STOP

DATA1 DCD 0XAAAAAAAA
      DCD 0X55555555

END
